 include/ctranslate2/layers/whisper.h     | 8 +++++++-
 include/ctranslate2/utils.h              | 2 ++
 python/cpp/module.cc                     | 3 +++
 python/cpp/whisper.cc                    | 3 ++-
 python/ctranslate2/__init__.py           | 1 +
 src/layers/flash_attention.cc            | 4 +++-
